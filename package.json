{
  "name": "dsh-sidebar-manager",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) 侧边栏管理器：查看左侧边栏的全部功能项，并逐项开关显示状态",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs",
    "test:render": "node test/render.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taoggt/dsh-sidebar-manager.git"
  },
  "homepage": "https://github.com/taoggt/dsh-sidebar-manager#readme",
  "bugs": {
    "url": "https://github.com/taoggt/dsh-sidebar-manager/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
